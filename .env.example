# ───────────────────────── Backend (copy to backend/.env) ─────────────────────────
NODE_ENV=development
PORT=5000

# MongoDB connection string. Leave empty (or set USE_IN_MEMORY_DB=true) to run
# against an auto-seeded in-memory MongoDB — no installation required.
MONGODB_URI=mongodb://127.0.0.1:27017/bookease
USE_IN_MEMORY_DB=false

# Wipe and load demo data on every start (in-memory mode seeds automatically).
SEED_ON_START=false

# JWT signing secret — use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Allowed browser origin(s) for CORS (comma separated) and base URL for email links.
CLIENT_URL=http://localhost:5173

# Business rules
CANCELLATION_WINDOW_HOURS=2
BOOKING_HORIZON_DAYS=60

# SMTP (Nodemailer). If SMTP_HOST is empty, emails are rendered and logged but not sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="BookEase <no-reply@bookease.local>"

# ───────────────────────── Frontend (optional, copy to frontend/.env) ─────────────
# API base URL. Defaults to /api, which the Vite dev server proxies to the backend.
# VITE_API_URL=/api
# Backend address used by the Vite proxy during development.
# VITE_PROXY_TARGET=http://localhost:5000
